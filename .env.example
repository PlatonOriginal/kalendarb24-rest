# Код и ключ локального приложения: «Разработчикам → Другое → Локальное приложение» на портале
B24_CLIENT_ID=local.xxxxxxxxxxxxxx.xxxxxxxx
B24_CLIENT_SECRET=

# Адрес, по которому браузер открывает приложение
APP_URL=https://localhost:8443

DB_HOST=db
DB_NAME=kb24rest
DB_USER=kb24rest
DB_PASSWORD=kb24rest

# 1: автор может оказаться согласующим своей заявки (удобно проверять всё под одним аккаунтом).
# Перед публикацией в Маркете выключить: 0
ALLOW_SELF_APPROVAL=1

{
    "name": "platonoriginal/kalendarb24-rest",
    "description": "Планирование отпусков: тиражное REST-приложение для Маркета Битрикс24",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-pdo": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Kb24Rest\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kb24Rest\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
